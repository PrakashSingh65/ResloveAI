# ==============================================================================
# ResolveAI Server — Environment Configuration Template (.env.example)
# Copy this file to `.env` and configure with your credentials before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# [Optional] Project branding
PROJECT_NAME="ResolveAI Server"

# [Required] Environment: "development", "production", or "testing"
# NOTE: In "production", SECRET_KEY must be a strong 32+ character random secret.
ENVIRONMENT="development"

# [Optional] Toggle verbose SQL and debug logs
DEBUG=False

# [Optional] Host interface and listening port
HOST="0.0.0.0"
PORT=8000


# ------------------------------------------------------------------------------
# 2. CLIENT & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# [Required] URL of the Next.js / frontend client (used for OAuth redirects)
FRONTEND_URL="http://localhost:3000"

# [Required] Allowed CORS origins (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# [Required] Neon PostgreSQL connection string
# Example: postgresql://<user>:<password>@<endpoint>.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require"

# [Optional] Pooled connection string (for high-concurrency environments)
DATABASE_URL_POOLED="postgresql://username:password@ep-something-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# [Optional] Echo raw SQL statements to console (default: False)
SQL_ECHO=False


# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS & EXPIRATION
# ------------------------------------------------------------------------------
# [Required] Cryptographic secret used to sign JWT Access Tokens.
# Generate in terminal: openssl rand -hex 32
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-security"

# [Optional] Dedicated secret for Refresh Tokens (defaults to SECRET_KEY if omitted)
# Generate in terminal: openssl rand -hex 32
REFRESH_SECRET_KEY="replace-with-a-separate-random-32-byte-hex-string"

# [Optional] JWT signature algorithm
ALGORITHM="HS256"

# [Optional] Token expiration windows
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------------------------
# 5. COOKIE CONFIGURATION (HttpOnly Pure Cookie Auth)
# ------------------------------------------------------------------------------
# [Optional] Cookie names
COOKIE_ACCESS_NAME="access_token"
COOKIE_REFRESH_NAME="refresh_token"

# [Optional] SameSite policy ("lax", "strict", or "none")
COOKIE_SAMESITE="lax"

# [Optional] Domain scope for cookies (leave unset for local dev; e.g. ".yourdomain.com" in prod)
# COOKIE_DOMAIN=".yourdomain.com"

# [Optional] Force Secure flag on cookies (true = HTTPS only; defaults to true in production, false in dev)
# COOKIE_SECURE=false


# ------------------------------------------------------------------------------
# 6. NEON MANAGED BETTER AUTH (Google & Social Login)
# ------------------------------------------------------------------------------
# [Required for Google OAuth] Base URL of your Neon Managed Better Auth instance
# Found in your Neon console under the Auth / Better Auth section.
NEON_AUTH_BASE_URL="https://ep-something.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"


# ------------------------------------------------------------------------------
# 7. AI & LLM AGENT CONFIGURATION (Groq & Google Gemini)
# ------------------------------------------------------------------------------
# [Optional] Google Gemini API Key for RAG embeddings and executive briefings
GEMINI_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"
VECTOR_DIMENSION=768

# [Optional] Groq API Key for ultra-fast customer chatbot & intent classification
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
