# ==============================================================================
# ResolveAI Server Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Configuration
PROJECT_NAME="ResolveAI Server"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Settings (Client Next.js URL)
CORS_ORIGINS=["http://localhost:3000"]

# Neon PostgreSQL Database Connection
# Example: postgresql+asyncpg://<username>:<password>@<ep-something>.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL=""

# JWT Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Keys for Agent & RAG
GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# pgvector / RAG Configuration
EMBEDDING_MODEL="text-embedding-004"
VECTOR_DIMENSION=768
